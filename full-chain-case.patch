+        self._process(t, HOST_A, FOOTHOLD_USER, foothold_lid, cmd_exe, ps, command_line=dump_cmd)
+        self._sysmon_create(t, HOST_A, FOOTHOLD_USER, cmd_exe, ps, dump_cmd, foothold_lid)
+        t += timedelta(seconds=self.rng.uniform(0.1, 0.5))
+        rundll_cmd = f"rundll32.exe C:\\Windows\\System32\\comsvcs.dll, MiniDump {DUMP_PID} {DUMP_FILE} full"
+        self._process(t, HOST_A, FOOTHOLD_USER, foothold_lid, DUMPER_IMAGE, cmd_exe,
