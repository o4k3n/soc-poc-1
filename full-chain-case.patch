+    # -- the attack: five stages, WKS-A -> WKS-B -> DC ---------------------------------
+    def attack(self) -> None:
+        sm = parse_evtx(self.evtx_dir / "sysmon_10_lsass_mimikatz_sekurlsa_logonpasswords.evtx")
+        lm_wmi = parse_evtx(self.evtx_dir / "LM_WMI_4624_4688_TargetHost.evtx")
+        lm_task = parse_evtx(self.evtx_dir / "LM_ScheduledTask_ATSVC_target_host.evtx")
+        dcs = parse_evtx(self.evtx_dir / "CA_DCSync_4662.evtx")
+        sample_access = next(e for e in sm if e["event_id"] == 10)
+        sample_logon = next(e for e in lm_wmi if e["event_id"] == 4624
+                            and e.get("LogonType") == "3" and e.get("IpAddress", "").count(".") == 3)
+        sample_task = next(e for e in lm_task if e["event_id"] == 4698)
+        sample_dcsync = next(e for e in dcs if e["event_id"] == 4662)
+        self.ground_truth["evtx_source_records"] = (
+            f"Sysmon 10 GrantedAccess {sample_access['GrantedAccess']}; "
+            f"LM 4624 type {sample_logon['LogonType']} proc {sample_logon.get('LogonProcessName')}; "
+            f"LM 4698 task {sample_task.get('TaskName')}; "
+            f"CA 4662 AccessMask {sample_dcsync.get('AccessMask')} "
+            f"replication properties present={'Properties' in sample_dcsync}"
+        )
