+        # STAGE 1 -- FOOTHOLD on WKS-A: phished user, OUTLOOK -> powershell -Enc.
+        t = FOOTHOLD_AT
+        foothold_lid = self._logon_id()
+        self._logon(t, HOST_A, FOOTHOLD_USER, FOOTHOLD_SID, "2", "-", HOST_A, foothold_lid,
+                    proc="User32", pkg="Negotiate")
+        t += timedelta(seconds=self.rng.uniform(3, 8))
