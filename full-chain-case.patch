+    "RwBlAHQALQBDAGkAbQBJAG4AcwB0AGEAbgBjAGUAIABXAGkAbgAzADIAXwBMAG8AZwBpAGMAYQBsAEQAaQBzAGsA",
+]
+
+WINDOW_START = datetime(2026, 9, 9, 8, 0, 0, tzinfo=timezone.utc)
+WINDOW_END = WINDOW_START + timedelta(hours=3)
+SPAN_S = (WINDOW_END - WINDOW_START).total_seconds()
