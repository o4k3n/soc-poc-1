+# is not the signal; the parent (OUTLOOK) and what the payload does are.
+BENIGN_ENC = [
+    "powershell.exe -NonInteractive -EncodedCommand "
+    "RwBlAHQALQBXAG0AaQBPAGIAagBlAGMAdAAgAFcAaQBuADMAMgBfAE8AcABlAHIAYQB0AGkAbgBnAFMAeQBzAHQAZQBtAA==",
