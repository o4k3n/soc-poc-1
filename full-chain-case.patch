+        # principal that is not a DC: AccessMask 0x100 (control access) and the
+        # DS-Replication-Get-Changes GUID(s) in Properties.
+        self._emit(ts, "security", {
+            "ts": _iso(ts), "event_id": 4662, "channel": "Security", "computer": computer,
+            "provider": "Microsoft-Windows-Security-Auditing",
+            "SubjectUserName": user, "SubjectDomainName": DOMAIN, "SubjectUserSid": sid,
+            "SubjectLogonId": logon_id, "ObjectServer": "DS", "ObjectType": DS_OBJECT_TYPE,
