# Commander instance: openai/gpt-oss-120b, native MXFP4, port 8000.
#
# This file is the single source of truth for the commander's share of the Spark's
# unified memory. config/config.toml deliberately does not repeat it.

COMMANDER_MODEL=openai/gpt-oss-120b
# Must match [models.commander].model in config/config.toml. health_check.py asserts it.
COMMANDER_SERVED_NAME=gpt-oss-120b

# ~70 GB of the 128 GB pool. Weights are ~60 GB at MXFP4, so this leaves roughly 10 GB
# for KV cache and activations -- enough for the small-batch, long-context, latency-
# indifferent work this commander does. Raise it only by taking memory from the grunt
# instance, and re-check `free -g` while both are loaded.
COMMANDER_GPU_FRACTION=0.55
COMMANDER_MAX_MODEL_LEN=32768
# Small: the commander issues a handful of large, sequential calls, not a stream of
# concurrent ones.
COMMANDER_MAX_NUM_SEQS=4

COMMANDER_STRUCTURED_OUTPUT_BACKEND=xgrammar

# --- MXFP4 on GB10/SM121 -------------------------------------------------------------
# READ THIS BEFORE DEBUGGING AN EMPTY RESPONSE.
#
# SM121 has no native FP4 compute path, so vLLM falls back to Marlin kernels written for
# SM80. vllm-project/vllm#37030 (open at time of writing) reports that this corrupts the
# first Harmony control token for gpt-oss, and the visible symptom is a 200 OK with
# "content": null. `make health` catches it deliberately.
#
# Recipes that have worked for others on this hardware differ by vLLM build, so none of
# them are enabled by default here. Try them one at a time, and record which one worked
# for your pinned image:
#
#   VLLM_USE_FLASHINFER_MOE_MXFP4_MXFP8=1     # official Blackwell recipe knob
#   VLLM_MXFP4_BACKEND=marlin                 # explicit backend selection (newer builds)
#   COMMANDER_EXTRA_ARGS=--quantization mxfp4 --mxfp4-backend CUTLASS --moe-backend marlin
#   COMMANDER_EXTRA_ARGS=--attention-backend FLASHINFER --kv-cache-dtype fp8
#
# Do NOT set --reasoning-parser openai_gptoss without testing: it has been reported to
# route the entire response into the reasoning channel, leaving content empty -- which
# looks identical to the kernel bug from the client's side.
#
# If none of it works, the fallback is a config swap, not a code change: serve a
# known-good model here (see the commented [models.commander] block in
# config/config.toml) and keep going. The commander's contract is a JSON schema; the
# model behind it is interchangeable.
COMMANDER_EXTRA_ARGS=
