+    def background_processes(self, n: int) -> None:
+        for _ in range(n):
+            ts = self._rand_ts()
+            host, _ip = self.rng.choice(HOSTS)
+            user = self.rng.choice(USERS)
+            image = self.rng.choice(BENIGN_IMAGES).format(user=user)
