+            self._process(ts, host, user, logon_id, image, parent)
+            if self.rng.random() < 0.6:
+                self._sysmon_create(ts, host, user, image, parent, f'"{image}"', logon_id)
+
+    def background_dc(self, n: int) -> None:
+        """Kerberos ticketing (4768/4769/4776) and -- crucially -- benign directory
+        replication: DC-to-DC 4662 with the replication GUIDs, by machine accounts. These
+        carry the exact Properties the DCSync does; the discriminator is the requesting
+        principal (a DC$ vs svc_backup), not the GUID."""
+        for _ in range(n):
+            ts = self._rand_ts()
+            user = self.rng.choice(USERS)
+            roll = self.rng.random()
+            if roll < 0.75:
+                eid = self.rng.choice([4768, 4769, 4776])
+                self._emit(ts, "security", {
+                    "ts": _iso(ts), "event_id": eid, "channel": "Security", "computer": DC_HOST,
