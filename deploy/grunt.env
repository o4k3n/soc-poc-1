# Grunt fleet: one Qwen3-8B-FP8 instance serving every worker, port 8001.
#
# One instance, not one per agent. Concurrency comes from vLLM's continuous batching.

# Apply changes to this file with:  make restart-grunt
#   (single-service restart; the other model keeps serving throughout)

GRUNT_MODEL=Qwen/Qwen3-8B-FP8
# Must match [models.grunt].model in config/config.toml.
GRUNT_SERVED_NAME=qwen3-8b

# ~28.7 GiB of the ~119.6 GiB vLLM sees. Weights are ~9.5 GB at FP8, so most of this is
# KV cache headroom, which is the point: this is the instance that actually sees
# concurrency (a whole planning round's worth of grunts at once, each possibly retrying).
#
# Trimmed from 0.28 to 0.24 to fund the commander, which needs 0.64 to hold any KV cache
# at all -- see the measured breakdown in deploy/commander.env. 0.64 + 0.24 = 0.88 of
# ~119.6 GiB, leaving ~14 GiB for the OS, page cache, container runtime and the
# orchestrator. (Omitting the flag would default to 0.92 and collide with the commander.)
GRUNT_GPU_FRACTION=0.24
GRUNT_MAX_MODEL_LEN=16384
# Grunt tasks arrive in bursts of up to max_tasks_per_iteration (config.toml) and each
# may re-prompt once, so leave room for the whole round plus retries.
GRUNT_MAX_NUM_SEQS=8

GRUNT_STRUCTURED_OUTPUT_BACKEND=xgrammar

# --- FP8 on SM121: DeepGEMM must be off ----------------------------------------------
# Qwen3-8B-FP8 ships block-wise FP8 scales, and vLLM routes those through DeepGEMM by
# default (VLLM_USE_DEEP_GEMM=1). On GB10 that fails at weight load:
#
#   fp8_utils.py deepgemm_post_process_weight_scale_block
#     -> deep_gemm.py transform_sf_into_required_layout
#     -> RuntimeError: Assertion error (layout.hpp:59): Unknown SF transformation
#
# DeepGEMM's scale-factor layout transform has no case for this architecture. Turning it
# off drops back to the generic FP8 path, which works. This costs throughput on hardware
# where DeepGEMM would have applied -- irrelevant here, and it is the difference between
# a serving grunt fleet and none.
#
# Verify on a vLLM bump: if DeepGEMM grows SM121 support, delete this line.
VLLM_USE_DEEP_GEMM=0

# Quantization itself is auto-detected from the checkpoint (`fp8`), so no flag is needed.
# If the FP8 checkpoint still will not load, two fallbacks, in order:
#   GRUNT_MODEL=Qwen/Qwen3-8B and GRUNT_EXTRA_ARGS=--quantization fp8   (per-tensor scales
#                                                                       on load, no blocks)
#   GRUNT_MODEL=Qwen/Qwen3-8B with no quantization at all              (~16 GB, still fits)
#
# Thinking mode: Qwen3 is a hybrid reasoning model and its <think> blocks fight with
# guided decoding. It is disabled per-request from the client
# (extra_body.chat_template_kwargs.enable_thinking=false in config.toml) rather than
# here, because it is a request-level property. If your chat template ignores that
# kwarg, the server-side equivalent in vLLM 0.24.0 is:
#   GRUNT_EXTRA_ARGS=--structured-outputs-config.enable_in_reasoning true
GRUNT_EXTRA_ARGS=--structured-outputs-config.disable_any_whitespace true
