# Commander instance: openai/gpt-oss-120b, native MXFP4, port 8000.
#
# This file is the single source of truth for the commander's share of the Spark's
# unified memory. config/config.toml deliberately does not repeat it.

COMMANDER_MODEL=openai/gpt-oss-120b
# Must match [models.commander].model in config/config.toml. health_check.py asserts it.
COMMANDER_SERVED_NAME=gpt-oss-120b

# MEASURED, not estimated. First boot at 0.55 failed with "No available memory for the
# cache blocks", and the profiler printed why:
#
#   vLLM sees ~119.6 GiB of device memory (not the nominal 128 GB)
#   model loading took          66.14 GiB   <- NOT the 60.77 GiB on disk; MXFP4 scales
#                                              and padding cost ~5 GiB on load
#   estimated CUDA graph memory  1.60 GiB
#   available KV cache memory   -1.95 GiB   <- i.e. 0.55 was ~2 GiB short of viable
#
# So the floor for this model is ~0.57 just to start, and anything useful needs more.
# 0.64 gives ~76.5 GiB, leaving ~8.8 GiB of KV cache after weights and CUDA graphs.
#
# Watch the "Available KV cache memory" and "maximum concurrency" lines on every boot;
# they are the ground truth for this number, and they move when the model, the context
# length, or the vLLM version changes.
#
# The default if you omit this flag is 0.92, which NVIDIA's release notes name as the
# cause of OOM on unified-memory systems. Explicit fractions are the documented fix, not
# a preference. Raise this only by taking memory from the grunt instance, and re-check
# `free -g` with both models loaded.
COMMANDER_GPU_FRACTION=0.64
# 16k, not 32k: the KV cache must hold at least one full-length sequence, and the largest
# prompt this commander ever builds (alert + summaries + every grunt report) is a few
# thousand tokens. Paying for 32k of headroom out of an 8.8 GiB KV budget buys nothing.
COMMANDER_MAX_MODEL_LEN=16384
# Small: the commander issues a handful of large, sequential calls, not a stream of
# concurrent ones.
COMMANDER_MAX_NUM_SEQS=4

# vLLM 0.24.0 exposes this as a nested JSON config arg; the dotted form below is
# equivalent to --structured-outputs-config '{"backend": "xgrammar"}'. Default is
# 'auto'. Other fields on the same config, should you need them:
#   .disable_any_whitespace        tighter JSON, fewer wasted tokens
#   .disable_additional_properties
#   .enable_in_reasoning           structured output inside reasoning-model output
COMMANDER_STRUCTURED_OUTPUT_BACKEND=xgrammar

# --- gpt-oss MXFP4 on GB10/SM121 -----------------------------------------------------
# Verified in nvcr.io/nvidia/vllm:26.07-py3 (vLLM 0.24.0) on this box:
#   * torch reports compute capability (12, 1) -- GB10 is sm_121, served by the sm_120
#     family binaries and compute_120 PTX that this image ships.
#   * the registered quantization methods include BOTH `mxfp4` and `gpt_oss_mxfp4`, so
#     gpt-oss has a dedicated path here. Quantization is auto-detected from the model
#     config; do not pass --quantization unless you are overriding that.
#
# This is NVIDIA's own DGX Spark image, so the upstream Marlin fallback bug
# (vllm-project/vllm#37030, which produced `"content": null` on the community
# vllm/vllm-openai images) is not the expected failure mode. `make health` still proves
# it rather than assuming it -- a guided-JSON round trip is cheap and the symptom is
# otherwise invisible until mid-investigation.
#
# If something does go wrong, these are the flags that EXIST in 0.24.0 (the older
# --mxfp4-backend / --mxfp4-layers / --moe-backend recipes floating around online are
# from earlier builds and will be rejected here):
#
#   --quantization mxfp4              force the generic path
#   --quantization-config <json>      per-layer-kind specs (linear, moe) + ignore patterns
#   --kv-cache-dtype fp8              buys KV headroom if 0.55 turns out too tight
#   --attention-backend <name>        override backend selection
#   --async-scheduling                throughput, irrelevant here, listed for completeness
#
# Do NOT set --reasoning-parser without testing. In 0.24.0 it lives under
# StructuredOutputsConfig, and a mismatched parser routes the entire response into the
# reasoning channel, leaving `content` empty -- which looks identical to a kernel
# problem from the client's side. This is now the likelier of the two empty-content
# causes on this image.
#
# Last resort is a config swap, not a code change: serve a known-good model here (see
# the commented [models.commander] block in config/config.toml) and keep going. The
# commander's contract is a JSON schema; the model behind it is interchangeable.
COMMANDER_EXTRA_ARGS=
