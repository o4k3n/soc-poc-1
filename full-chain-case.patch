+         "r.delgado", "k.andersson", "l.moreau", "d.ferreira", "n.yamamoto", "e.kovac"]
+HOSTS = [("WKS-5510", "10.12.34.31"), ("WKS-5523", "10.12.34.33"),
+         ("WKS-5534", "10.12.34.34"), ("WKS-5540", "10.12.34.40"),
+         ("WKS-5551", "10.12.34.51"), ("WKS-5562", "10.12.34.62"),
+         (HOST_A, IP_A), (HOST_B, IP_B)]
