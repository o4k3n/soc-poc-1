+    # -- render ------------------------------------------------------------------------
+    def render(self, channel: str) -> str:
+        rows = sorted((r for r in self.rows if r[1] == channel), key=lambda r: r[0])
+        return "\n".join(json.dumps(o, separators=(",", ":")) for _t, _c, o in rows) + "\n"
