+        ps = r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
+        self._process(t, HOST_A, FOOTHOLD_USER, foothold_lid, ps, outlook, command_line=FOOTHOLD_CMD)
+        self._sysmon_create(t, HOST_A, FOOTHOLD_USER, ps, outlook, FOOTHOLD_CMD, foothold_lid)
+        t += timedelta(seconds=self.rng.uniform(0.5, 1.5))
+        self._sysmon_net(t, HOST_A, ps, "185.199.108.7", 80)
+
+        # STAGE 2 -- CREDENTIAL ACCESS on WKS-A: the foothold dumps LSASS.
+        t = DUMP_AT
