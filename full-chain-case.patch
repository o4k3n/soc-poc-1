+        # STAGE 3 -- LATERAL MOVEMENT WKS-A -> WKS-B as svc_backup (the LSASS loot). The
+        # type-3 logon comes FROM WKS-A's IP; WmiPrvSE -> cmd is the alert's tip.
+        t = LATERAL_AT
